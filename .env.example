# Copy this file to .env for local development (with `vercel dev`), and set
# the same values as Environment Variables in the Vercel project dashboard
# for production/preview deployments.

# Admin login for /admin (the client-requests inbox)
ADMIN_EMAIL=admin@summitconsultancy.com
ADMIN_PASSWORD=change-me

# Signs the admin session token. Use a long random string.
JWT_SECRET=change-me-too

# From your Supabase project: Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is a secret — it bypasses Row Level Security.
# Never expose it to the browser or commit it; it's only read server-side
# inside /api functions.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications for new client requests (Resend).
# RESEND_API_KEY is added automatically by the Resend Vercel integration.
RESEND_API_KEY=
# Where new-request alerts are delivered. Defaults to hilalelayoubi1@gmail.com
# if unset (see api/_lib/email.ts).
NOTIFICATION_EMAIL=hilalelayoubi1@gmail.com
# Verified Resend sender. Leave unset to use Resend's shared onboarding
# address (onboarding@resend.dev), which only delivers to your own Resend
# account email until you verify a domain.
NOTIFICATION_FROM=
