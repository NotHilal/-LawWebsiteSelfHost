# Copy this file to .env (production, on the server) or .env.local (local dev).
# The Express server loads it automatically via dotenv. Never commit the real file.

# Port the Express server listens on (o2switch / Passenger sets this itself).
PORT=3001

# Public origin of the site, e.g. https://www.summitconsultancy.com
# Used only to build the "view in admin" link inside notification emails.
PUBLIC_BASE_URL=

# --- Admin login for /admin (the client-requests inbox) ---------------------
ADMIN_EMAIL=admin@summitconsultancy.com
ADMIN_PASSWORD=change-me

# Signs the admin session token. Use a long random string.
JWT_SECRET=change-me-too

# --- Client requests storage (SQLite) ---------------------------------------
# Stored locally in <DATA_DIR>/requests.db — nothing to provision. Defaults to
# ./data next to the server process; only set this to point it somewhere else
# (e.g. a persistent volume path).
DATA_DIR=

# --- Gemini (chatbot) -----------------------------------------------------
GOOGLE_API_KEY=

# --- Email notifications for new client requests (SMTP) -------------------
# o2switch: cPanel -> Email Accounts -> "Connect Devices" shows the exact
# host / ports for a mailbox you create (e.g. contact@your-domain.fr).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@your-domain.fr
SMTP_PASS=
# Where alerts are delivered. Defaults to SMTP_USER if unset. Can be any address.
NOTIFICATION_EMAIL=
# From header. Defaults to "Summit Website <SMTP_USER>". Must be an address the
# SMTP account is allowed to send as (normally SMTP_USER itself).
NOTIFICATION_FROM=
